# SAP AI Core / Generative AI Hub
AICORE_AUTH_URL=
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=default

# A2A discovery URL (local only until authenticated deployment wiring exists)
A2A_PUBLIC_URL=http://localhost:8080

# SAP HANA Cloud
HANA_ADDRESS=
HANA_PORT=443
HANA_USER=
HANA_PASSWORD=
HANA_ENCRYPT=true
HANA_SSL_VALIDATE_CERTIFICATE=true

# Optional remote MCP server
MCP_URL=
MCP_KEY=
