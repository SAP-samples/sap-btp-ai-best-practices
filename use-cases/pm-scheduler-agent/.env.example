# Copy this file to .env and fill in real values. NEVER commit the real .env.

# ── SAP Generative AI Hub (GenAIHub) ──────────────────────────────────────────
AICORE_AUTH_URL="https://<your-subaccount>.authentication.<region>.hana.ondemand.com"
AICORE_CLIENT_ID="<aicore-client-id>"
AICORE_CLIENT_SECRET="<aicore-client-secret>"
AICORE_BASE_URL="https://api.ai.<region>.aws.ml.hana.ondemand.com/v2"
AICORE_RESOURCE_GROUP="default"

# ── Gmail (schedule email delivery) ───────────────────────────────────────────
GMAIL_USER="<your-gmail-address>"
GMAIL_APP_PASSWORD="<gmail-app-password>"

# ── S/4HANA OData (orders + work centers data source) ─────────────────────────
S4_BASE_URL="https://<s4-host>:<port>"
S4_CLIENT="<client>"
S4_USERNAME="<s4-username>"
S4_PASSWORD="<s4-password>"
S4_VERIFY="false"
# Optional: path to a CA bundle to enable TLS verification instead of S4_VERIFY
# S4_CA_BUNDLE="/path/to/ca-bundle.pem"
