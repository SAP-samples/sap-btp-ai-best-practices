# SAP AI Core (Gen AI Hub) - model and reasoning effort are set in app/order_agent/config/agent.yaml
AICORE_AUTH_URL=""
AICORE_CLIENT_ID=""
AICORE_CLIENT_SECRET=""
AICORE_BASE_URL=""
AICORE_RESOURCE_GROUP=""

# SAP HANA Cloud
HANA_ADDRESS=""
HANA_PORT="443"
HANA_USER=""
HANA_PASSWORD=""
HANA_ENCRYPT="True"
# Optional: dedicated schema (created automatically if the user may CREATE SCHEMA)
HANA_SCHEMA=""
# Optional: set to "false" only for local tests against hosts with self-signed certificates
HANA_SSL_VALIDATE_CERTIFICATE="true"

# Order pipeline: set to "false" to run this instance without agent workers (API and UI only)
ORDER_PIPELINE_ENABLED="true"

# Optional salt for the user hash written to the LLM token-usage logs (any random string)
LOG_USER_HASH_SALT=""

# Shared secret expected in the X-API-Key header (also set as VITE_API_KEY in ui/.env)
API_KEY="your-super-secret-api-key"
