# Required: SAP BTP Generative AI Hub / SAP AI Core service key values
AICORE_AUTH_URL="https://<subaccount>.authentication.<region>.hana.ondemand.com"
AICORE_CLIENT_ID="<client-id>"
AICORE_CLIENT_SECRET="<client-secret>"
AICORE_BASE_URL="https://api.ai.<region>.prod.hana.ondemand.com"
AICORE_RESOURCE_GROUP="default"

# Required: shared demo API key. Use the same value in ui/.env.
API_KEY="replace-with-a-long-random-value"

# Local workspace for uploaded PDFs and generated artifacts
PR_WORKSPACE_ROOT="./app/data/purchase_requisition"

# Optional integrations are disabled by default.
DOCAI_ENABLED="false"
DOCAI_SERVICE_KEY_PATH="./dox_client/schemas/service_key.json"
S4_INTEGRATION_ENABLED="false"

# Optional S/4HANA direct connection for local development
S4_CONNECTION_MODE="auto"
S4_BASE_URL=""
S4_CLIENT=""
S4_USERNAME=""
S4_PASSWORD=""
S4_VERIFY="true"
S4_TIMEOUT="60"

# Optional S/4HANA connection through BTP Destination and Connectivity
S4_DESTINATION_NAME=""
DESTINATION_SERVICE_URI=""
DESTINATION_TOKEN_BASE_URL=""
DESTINATION_CLIENT_ID=""
DESTINATION_CLIENT_SECRET=""
CONNECTIVITY_PROXY_HOST=""
CONNECTIVITY_PROXY_PORT="20003"
CONNECTIVITY_TOKEN_BASE_URL=""
CONNECTIVITY_CLIENT_ID=""
CONNECTIVITY_CLIENT_SECRET=""

# Optional PR defaults. Replace with values valid in your S/4HANA system.
S4_PR_DEFAULT_SUPPLIER=""
S4_PR_DEFAULT_PLANT="1000"
S4_PR_DEFAULT_PURCHASING_ORG=""
S4_PR_DEFAULT_PURCHASING_GROUP="001"
S4_PR_DEFAULT_COMPANY_CODE="1000"
S4_PR_DEFAULT_MATERIAL_GROUP="DEMO001"
S4_PR_DEFAULT_ACCOUNT_ASSIGNMENT_CATEGORY=""
S4_PR_DEFAULT_MATERIAL="DEMO-MAT-001"
S4_PR_DEFAULT_BASE_UNIT="EA"
S4_PR_DEFAULT_UNIT_PRICE="1.00"
S4_PR_DEFAULT_CURRENCY="USD"
S4_MASTER_DATA_CACHE_SECONDS="300"
