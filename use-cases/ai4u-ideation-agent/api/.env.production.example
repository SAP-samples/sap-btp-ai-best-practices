# AI4U Ideation Agent — Production Environment (CF deployment)
#
# On Cloud Foundry, XSUAA, AI Core, and Object Store credentials are
# auto-discovered from VCAP_SERVICES (bound services in manifest.yaml).
# Only HANA and admin config need explicit env vars.
#
# Quick setup: Run ./setup.sh (generates this file automatically).
# Manual setup: Copy this file to api/.env.production and fill in values.
#
# See api/.env.example for all available variables (including local dev).

# === REQUIRED ===

# HANA Cloud — technical user with DDL privileges on your schema
HANA_HOST=
HANA_PORT=443
HANA_USER=
HANA_PASSWORD=
HANA_ENCRYPT=true
HANA_SCHEMA=

# Admin users (comma-separated emails that get admin access)
ADMIN_EMAILS=

# === OPTIONAL FEATURES (uncomment to enable) ===

# CDC - External user OTP login
# CDC_API_KEY=""
# CDC_DATA_CENTER="us1.gigya.com"
# CDC_USER_KEY=""
# CDC_SECRET_KEY=""

# Perplexity research (requires Sonar model deployed in AI Core)
# IDEATION_PERPLEXITY_SKILL_ENABLED="true"

# LinkedIn hiring intelligence
# IDEATION_LINKEDIN_SKILL_ENABLED="true"
