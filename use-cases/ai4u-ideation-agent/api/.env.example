# === REQUIRED SERVICES ===

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ On Cloud Foundry: XSUAA, AI Core, and Object Store credentials are         │
# │ auto-discovered from VCAP_SERVICES (bound services in manifest.yaml).      │
# │ You only need these env vars for LOCAL DEVELOPMENT.                        │
# └─────────────────────────────────────────────────────────────────────────────┘

# XSUAA Authentication (from: cf service-key <xsuaa-instance> <key-name>)
# CF: auto-discovered from VCAP_SERVICES → not needed in .env.production
XSUAA_URL=""
XSUAA_CLIENT_ID=""
XSUAA_CLIENT_SECRET=""

# SAP AI Core / Gen AI Hub (LLM calls + orchestration)
# CF: auto-discovered from VCAP_SERVICES → not needed in .env.production
# The SDK auto-discovers orchestration deployments from these credentials.
AICORE_AUTH_URL=""
AICORE_CLIENT_ID=""
AICORE_CLIENT_SECRET=""
AICORE_BASE_URL=""
AICORE_RESOURCE_GROUP="default"

# Object Store (file uploads — S3-compatible)
# CF: auto-discovered from VCAP_SERVICES → not needed in .env.production
OBJECT_STORE_ACCESS_KEY_ID=""
OBJECT_STORE_SECRET_ACCESS_KEY=""
OBJECT_STORE_BUCKET=""
OBJECT_STORE_REGION="eu-central-1"
# OBJECT_STORE_HOST=""  # Only needed for non-AWS S3-compatible endpoints

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ HANA Cloud — always required (both local and CF).                          │
# │ Uses a technical DDL user, not the service binding user.                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# HANA Cloud (persistence — conversations, submissions, canvas, shares, events)
HANA_HOST=""
HANA_PORT="443"
HANA_USER=""
HANA_PASSWORD=""
HANA_ENCRYPT="true"
HANA_SCHEMA=""

# Admin users (comma-separated emails that get admin access)
ADMIN_EMAILS=""

# === OPTIONAL FEATURES ===

# CDC - External user OTP login (disabled when CDC_API_KEY not set)
# Enables a second login path for non-XSUAA users via SAP Customer Data Cloud.
# CDC_API_KEY=""
# CDC_DATA_CENTER="us1.gigya.com"
# CDC_USER_KEY=""
# CDC_SECRET_KEY=""
# CDC_PUBLIC_EMAIL_DOMAINS="gmail.com,hotmail.com,outlook.com,yahoo.com,icloud.com"

# CSE - Company Search Engine (SAP-internal only, disabled when CSE_URL not set)
# CSE_URL=""
# CSE_KEY=""
# CSE_HTTP_TIMEOUT_SECONDS="30"

# Perplexity - AI research enrichment via AI Core Orchestration (disabled by default)
# Uses Perplexity Sonar models deployed in your AI Core instance.
# Requires an orchestration deployment with Sonar model access in AI Core.
# IDEATION_PERPLEXITY_SKILL_ENABLED="true"
# IDEATION_PERPLEXITY_SONAR_PRO_MODEL="sonar-pro"
# IDEATION_PERPLEXITY_MAX_TOKENS="1800"

# LinkedIn - Hiring intelligence via public job listings (disabled by default)
# Scrapes LinkedIn guest APIs for job postings, analyzes with LLM.
# IDEATION_LINKEDIN_SKILL_ENABLED="true"

# === OPTIONAL TUNING (all have sensible defaults — override only if needed) ===

# LLM model and temperature overrides
# AGENT_INTERVIEW_TEMPERATURE="0.5"
# AGENT_FINAL_TEMPERATURE="0.2"
# REIMAGINE_LLM_MODEL="gpt-5.4"
# REIMAGINE_TEMPERATURE="0.7"
# PROVOCATEUR_LLM_MODEL="gpt-5.4"
# PROVOCATEUR_TEMPERATURE="0.4"
# CATALOG_MATCH_MODEL="gemini-2.5-flash"
# Conversation-title generation model (fast/cheap, NON-reasoning; must be deployed in
# your AI Core). Reasoning models return empty output at this small token budget.
# IDEATION_TITLE_MODEL="gpt-4o-mini"

# Update notifications (checks for newer versions — enabled by default)
# Successful checks are cached for one hour. Disable with UPDATE_CHECK_ENABLED=false.
# UPDATE_CHECK_ENABLED="true"
# UPDATE_CHECK_URL="https://raw.githubusercontent.com/SAP-samples/sap-btp-ai-best-practices/main/use-cases/ai4u-ideation-agent/VERSION"
