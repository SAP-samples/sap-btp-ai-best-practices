# SAP AI Core
AICORE_AUTH_URL=""
AICORE_CLIENT_ID=""
AICORE_CLIENT_SECRET=""
AICORE_BASE_URL=""
AICORE_RESOURCE_GROUP=""

# SAP HANA Database Configuration
HANA_ADDRESS=""
HANA_PORT="443"
HANA_USER=""
HANA_PASSWORD=""
HANA_ENCRYPT="True"

# Other
API_KEY="your-super-secret-api-key"

# ECN impact runtime settings
LLM_MAX_CONCURRENCY="4"
LLM_REQUEST_TIMEOUT_SECONDS="180"
MAX_JSON_UPLOAD_BYTES="134217728"
MAX_WORKBOOK_UPLOAD_BYTES="104857600"
MAX_WORKBOOK_ROWS="100000"
MAX_WORKBOOK_CELLS="3000000"
MAX_PROMPT_EVIDENCE_ITEMS="100"
MAX_PROMPT_CHARACTERS="120000"
LLM_MODEL="gpt-5.4"

# Standalone PS4 drawing-feasibility workflow. It reuses LLM_MODEL,
# LLM_REQUEST_TIMEOUT_SECONDS, and LLM_MAX_CONCURRENCY above.
DRAWING_MAX_UPLOAD_BYTES="20971520"

# Leave the characteristic empty to keep rule-derived plant context disabled.
ECN_IMPACT_FOOTPRINT_BRAND_CHARACTERISTIC=""
ECN_IMPACT_PLANT_FOOTPRINT_MAP='{"JB":"Plant A","JD":"Plant B"}'
