# SAP AI Core
AICORE_AUTH_URL=""
AICORE_CLIENT_ID=""
AICORE_CLIENT_SECRET=""
AICORE_BASE_URL=""
AICORE_RESOURCE_GROUP=""

# SAP HANA Database Configuration
HANA_ADDRESS=""
HANA_PORT="443"
HANA_USER=""
HANA_PASSWORD=""
HANA_ENCRYPT="True"
# Optional: validate the HANA TLS certificate for the agent memory store (default true)
# HANA_SSL_VALIDATE_CERTIFICATE="true"

# SAP Document AI (Payment Advice Extractor)
# The service key is loaded from api/app/payment_advice/schema/service_key.json by
# default (git-ignored). For Cloud Foundry, inject it instead via one of these:
# DOCUMENT_AI_SERVICE_KEY_JSON=""
# DOCUMENT_AI_SERVICE_KEY_BASE64=""
# DOCUMENT_AI_SERVICE_KEY_PATH=""
DOCUMENT_AI_CLIENT_ID="ai4u_payment_advice"

# Pipeline LLMs: allowed values are gpt-5.6-luna and gemini-3.1-flash-lite
PAYMENT_ADVICE_MAPPER_MODEL="gpt-5.6-luna"
PAYMENT_ADVICE_AGENT_MODEL="gpt-5.6-luna"
PAYMENT_ADVICE_OUT_DIR="out"

# Priority-customer seed list (JSON, see app/payment_advice/seed_customers.json).
# Empty: the packaged anonymized demo list. Relative paths resolve against api/.
# PAYMENT_ADVICE_SEED_CUSTOMERS_PATH="app/payment_advice/schema/seed_customers.json"

# SAP S/4HANA (payment advice posting)
# auto: BTP Destination/Connectivity inside Cloud Foundry, direct otherwise.
S4_CONNECTIVITY_MODE="auto"
S4_CLIENT=""
S4_VERIFY="true"
# Direct mode (local development over SAP VPN, basic auth)
S4_BASE_URL=""
S4_USERNAME=""
S4_PASSWORD=""
# BTP mode (Cloud Foundry). Values come from the Destination and Connectivity
# service keys of the subaccount that holds the destination.
S4_DESTINATION_NAME="S4_HTTP"
DESTINATION_SERVICE_URI=""
DESTINATION_TOKEN_BASE_URL=""
DESTINATION_CLIENT_ID=""
DESTINATION_CLIENT_SECRET=""
CONNECTIVITY_PROXY_HOST=""
CONNECTIVITY_PROXY_PORT="20003"
CONNECTIVITY_TOKEN_BASE_URL=""
CONNECTIVITY_CLIENT_ID=""
CONNECTIVITY_CLIENT_SECRET=""
BTP_DEST_DEBUG="false"
# Payment advice creation
S4_PAYMENT_ADVICE_TYPE="04"
# Demo/test systems only: customer's documented company code -> company code in
# this S/4 system (e.g. "CA01=Z291"). Leave empty in production.
S4_COMPANY_CODE_ALIASES=""
# Demo/test systems only: customer's documented reason code -> reason code that
# exists in this S/4 company code (e.g. "316=060,319=060"). Leave empty in production.
S4_REASON_CODE_ALIASES=""
S4_AUTO_POST="false"

# Other
# Optional: salt for the hashed user ids in token-usage logs (default empty)
# LOG_USER_HASH_SALT=""
API_KEY="your-super-secret-api-key"