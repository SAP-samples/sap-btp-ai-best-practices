FROM python:3.12-slim-bookworm

# Install Xvfb, Chromium and all Playwright system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb xauth \
    chromium \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 \
    libatspi2.0-0 libxcomposite1 libxdamage1 libxrandr2 \
    libgbm1 libxkbcommon0 libasound2 libpango-1.0-0 \
    libcairo2 libx11-6 libxcb1 libxext6 libxfixes3 \
    fonts-liberation wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-kyma.txt .
RUN pip install --no-cache-dir -r requirements-kyma.txt

# Install Playwright Chromium binary alongside system one
RUN playwright install chromium

COPY extract.py kyma_wrapper.py ./

ENTRYPOINT ["python", "kyma_wrapper.py"]
