# ── SAP IBP configuration ───────────────────────────────────────────────
IBP_URL=https://<your-ibp-tenant>.scmibp.ondemand.com/
DEMO_ACCESS_URL=https://launchpad.support.sap.com/#/
SECURE_DEMO_URL=https://access.sap.com/
DOWNLOAD_DIR=./downloads
JOB_NAME=<your-ibp-job-name>

# ── SAP HANA Cloud (vectorEngine) ───────────────────────────────────────
# Provide real values only in your local `.env` file — never commit them.
HANA_ADDRESS="<your-hana-host>.hanacloud.ondemand.com"
HANA_PORT="443"
HANA_USER="<your-hana-user>"
HANA_PASSWORD="<your-hana-password>"
HANA_ENCRYPT="True"
HANA_SCHEMA="<your-hana-schema>"