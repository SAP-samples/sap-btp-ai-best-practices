# SAP S/4HANA Connection Details
S4_BASE_URL=https://your-s4-server:port
S4_CLIENT=550
S4_USERNAME=your_username
S4_PASSWORD=your_password

# Optional: SSL Certificate Verification
# Set to 'false' for development/testing only
S4_VERIFY=false
S4_CA_BUNDLE=

# Optional: Demo Sales Order ID for templates
DEMO_SO_ID=1

