# ============================================================
# CREDENCIALES Y CONFIGURACIÓN SENSIBLE
# ============================================================
# Archivo de credenciales SAP (clientid, clientsecret, token_url, etc.)
docai.json
**/docai.json
backend/docai.json
/backend/docai.json

# Variables de entorno (pueden contener API keys, URLs internas, etc.)
# Ignora cualquier .env en cualquier subdirectorio del repositorio
.env
.env.*
**/.env
**/.env.*
# Excepciones: archivos de ejemplo que SÍ deben versionarse
!**/.env.example
!**/.env_example
!frontend/.env.example
!backend/post/create/.env_example

# Otros archivos con secretos comunes
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json

