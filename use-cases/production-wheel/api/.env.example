# SAP AI Core
AICORE_AUTH_URL=""
AICORE_CLIENT_ID=""
AICORE_CLIENT_SECRET=""
AICORE_BASE_URL=""
AICORE_RESOURCE_GROUP=""

# SAP HANA Database Configuration
HANA_ADDRESS=""
HANA_PORT="443"
HANA_USER=""
HANA_PASSWORD=""
HANA_ENCRYPT="True"
# Optional: schema the app reads/writes. Empty = HANA_USER's own schema.
# Set it when logging in with one user (e.g. an admin) to work in another schema.
HANA_SCHEMA=""
# Optional: validate the HANA TLS certificate (default "true")
# HANA_SSL_VALIDATE_CERTIFICATE="true"

# User authentication (see docs/user-authentication.md)
# "xsuaa" (default, used in Cloud Foundry): validate the user JWT forwarded by the approuter.
# "local": laptop development without BTP; every request is the user "local-developer".
#          Refused when APP_ENV=production.
# "public": open showcase deployment without sign-in. Set only by manifest-public.yaml
#           (./deploy.sh public); never put it in this file.
AUTH_MODE="local"

# Other
# Optional: salt for the hashed user id written to token-usage logs (default empty)
# LOG_USER_HASH_SALT=""