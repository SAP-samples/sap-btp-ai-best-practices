{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/do/logout",
    "logoutPage": "/logout.html"
  },
  "routes": [
    {
      "source": "^/logout\\.html$",
      "localDir": "resources",
      "authenticationType": "none"
    },
    {
      "source": "^/api/(.*)$",
      "target": "/api/$1",
      "destination": "production-wheel-api",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.User",
      "csrfProtection": true
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "localDir": "resources",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.User"
    }
  ]
}
