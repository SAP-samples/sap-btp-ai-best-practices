# Runtime
APP_ENV="development"
HOST="0.0.0.0"
PORT="8000"
ALLOWED_ORIGIN=""
API_BASE_URL=""
AGENT_PUBLIC_URL=""

# Security
API_KEY="your-super-secret-api-key"

# SAP AI Core / Gen AI Hub
AICORE_AUTH_URL=""
AICORE_CLIENT_ID=""
AICORE_CLIENT_SECRET=""
AICORE_BASE_URL=""
AICORE_RESOURCE_GROUP=""

# Gen AI model configuration
GENAI_DEFAULT_MODEL="gpt-5.4"
GENAI_REVIEW_MODEL="gpt-5.4"
GENAI_REASONING_EFFORT="low"
GENAI_EMBEDDING_MODEL="text-embedding-3-small"
GENAI_TEMPERATURE="0.2"
GENAI_MAX_TOKENS="2048"

# Joule / A2A
JOULE_A2A_MODEL_NAME="gpt-4.1"

# SAP HANA Database Configuration
HANA_ADDRESS=""
HANA_PORT="443"
HANA_USER=""
HANA_PASSWORD=""
HANA_ENCRYPT="true"
