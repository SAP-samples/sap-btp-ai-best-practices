API_KEY="your-super-secret-api-key"
AICORE_AUTH_URL="https://your-auth-url"
AICORE_CLIENT_ID="your-client-id"
AICORE_CLIENT_SECRET="your-client-secret"
AICORE_BASE_URL="https://your-base-url/v2"
AICORE_RESOURCE_GROUP="default"
LOG_USER_HASH_SALT="replace-with-a-long-random-value"


# RPT-1 lifetime model: the AI Core deployment is discovered from the model name.
# Leave RPT1_MODEL_VERSION empty to accept any version of the named model.
RPT1_MODEL_NAME="sap-rpt-1-small"
RPT1_MODEL_VERSION=""

# HANA
hana_address=''
hana_port=''
hana_user=''
hana_password=''
hana_encrypt=''

# Assistant LLM deployed in AI Core (SAP Gen AI Hub model name).
A2A_MODEL="gpt-5.6-luna"
AGENT_PUBLIC_URL=""
